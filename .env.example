# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Financial data (Phase 1b) ---
FMP_API_KEY=your_financial_modeling_prep_key

# --- News (Phase 3) ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
NEWSAPI_KEY=optional_fallback_key

# --- Industry web research (Phase 3) ---
# Brave Search API (free tier) for allowlisted industry/macro research. Without
# it, the industry agent runs without live citations. See app/config/sources.yaml
# for the allowlist that filters every result.
BRAVE_API_KEY=optional_brave_search_key

# --- LLM (Phase 3) ---
# LLM calls go through OpenRouter (OpenAI-compatible). Use a free model in
# development; swap OPENROUTER_MODEL for a paid one later. Browse current free
# models at https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Behaviour ---
CACHE_DIR=data/cache
USE_CACHE=true
LOG_LEVEL=INFO

# Config versions are stamped onto every report (PRD 12.7 / 18-NF18).
WEIGHTS_CONFIG=app/config/weights.yaml
THRESHOLDS_CONFIG=app/config/thresholds.yaml
SOURCES_CONFIG=app/config/sources.yaml
